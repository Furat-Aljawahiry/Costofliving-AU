# Copy to .env to enable real data sources. App works WITHOUT any of these
# (it falls back to realistic mock data), so it is plug-and-play out of the box.

# Server port
PORT=4000

# Turn on live scraping of Woolworths' internal endpoint (free, may be rate-limited)
ENABLE_WOOLWORTHS=false

# Optional Apify token for reliable Coles/Woolworths scraping (paid)
APIFY_TOKEN=

# Decodo (ex-Smartproxy) residential egress for the Woolworths crawler CLI:
#   node data/scripts/crawl-woolworths-category.mjs --maxPages 1
# Leave blank to crawl direct from this machine. The deployed Lambda gets the
# same values from Terraform (infra/terraform/terraform.tfvars), not from here.
PROXY_URL=
PROXY_COUNTRY=au
PROXY_SESSION_MINUTES=30

# The archive. The server runs `aws s3 sync` into data/out/s3 at boot, on
# every POST /api/reload, and every SYNC_INTERVAL_MIN minutes (default 60), so
# it serves last night's run without a hand step. Needs the AWS CLI on PATH
# with credentials that can list and read the bucket.
#
# These four have working defaults in server/config.js and only need setting
# here to point somewhere else. Copying this file to .env is still worth doing
# — without a .env the server has no PORT, no proxy settings and no VITE_API_URL.
DATA_BUCKET=costofliving-au-data-207208119513
DATA_PREFIX=reports/supermarkets
AWS_REGION=ap-southeast-2
SYNC_INTERVAL_MIN=60

# Working offline? DATA_SYNC=off is the ONLY supported way to run without the
# archive. It is deliberately explicit: the server otherwise treats a failed
# sync at boot as fatal, because silently serving week-old prices is the one
# failure this whole path exists to prevent (the site sat on 17 Sep data for
# eight days in Sep 2026 because a missing .env turned the sync into a no-op).
# Set DATA_SYNC_REQUIRED=false to warn instead of exiting.
DATA_SYNC=on
DATA_SYNC_REQUIRED=true

# How old the newest capture may be before /api/status says stale=true and
# /api/health starts returning 503. Two missed 12-hourly runs.
STALE_AFTER_HOURS=48

# Where the CSVs are read from. Only set to point at a fixture tree.
# DATA_DIR=data/out

# Client: where the API lives (leave blank to use the dev proxy)
VITE_API_URL=
