{
  "name": "costofliving-au",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["server", "client"],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "sync-data": "aws s3 sync s3://costofliving-au-data-207208119513/reports/supermarkets data/out/s3 --region ap-southeast-2",
    "pull-reports": "python data/scripts/pull_latest_reports.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
